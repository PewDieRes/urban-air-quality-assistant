# Gemini API key and model for household smog planning
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.8-flash"

# NASA FIRMS Map Key for recent active fire detections
FIRMS_MAP_KEY="your-firms-map-key"

# Optional: URL of external HYSPLIT smoke trajectory service
SMOKE_SERVICE_URL=""
SMOKE_SERVICE_TOKEN=""

# Public deployment URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
