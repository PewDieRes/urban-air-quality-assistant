# Gemini API key and optional model override for household smog planning
# Defaults to gemini-3.5-flash-lite (retry: gemini-flash-lite-latest) in lib/plan/gemini.ts
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"

# NASA FIRMS Map Key for recent active fire detections
FIRMS_MAP_KEY="your-firms-map-key"

# Optional: URL of external HYSPLIT smoke trajectory service
SMOKE_SERVICE_URL=""
SMOKE_SERVICE_TOKEN=""

# Public deployment URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Browser 3D Tile Credentials for Immersive 3D City View
# Restrict the Google key to permitted sites and the Map Tiles API.
NEXT_PUBLIC_GOOGLE_MAPS_TILE_KEY=""

# Optional Cesium ion default access token for Cesium World Terrain (Asset 1) and OSM Buildings (Asset 96188).
NEXT_PUBLIC_CESIUM_ION_TOKEN=""

# Optional shared rate limiter for serverless deployments (both values required).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
